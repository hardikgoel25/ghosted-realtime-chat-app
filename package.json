{
  "name": "ghosted",
  "version": "2.0.0",
  "private": true,
  "description": "Ghosted — realtime chat app (monorepo: shared, backend, frontend)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run migrate -w backend && concurrently -n api,web -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:local": "node backend/src/scripts/local-mongo.js npm run dev",
    "build": "npm install --include=dev && npm run build -w frontend",
    "start": "npm run migrate -w backend && npm run start -w backend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w backend",
    "migrate": "npm run migrate -w backend",
    "seed": "npm run seed -w backend",
    "db:reset": "npm run db:reset -w backend --",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true
    }
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
