{
  "name": "backend",
  "version": "2.0.0",
  "private": true,
  "description": "Ghosted API and realtime server",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=./src --watch-path=../shared/src src/server.js",
