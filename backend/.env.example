# ---- Server ----
NODE_ENV=development
PORT=5001
# pino level: fatal | error | warn | info | debug | trace | silent (default: debug in dev, info in prod)
LOG_LEVEL=debug
# Comma-separated browser origins allowed to call the API with cookies (Vite dev server, production URL)
CLIENT_ORIGINS=http://localhost:5173
# Number of proxy hops to trust (1 on Render / behind Nginx, 0 locally). Defaults to 1 in production.
TRUST_PROXY=0

# ---- Database ----
# Any MongoDB: local install, Docker, or Atlas. For a zero-install local database run
# `npm run dev:local` from the repo root instead (it ignores this value).
MONGODB_URI=mongodb://127.0.0.1:27017/ghosted
# Only for mongodb+srv:// URIs on networks whose default DNS refuses SRV lookups
# (symptom: "querySrv ECONNREFUSED"). Comma-separated resolver IPs, e.g. 8.8.8.8,1.1.1.1
DNS_SERVERS=

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# Access token lifetime (e.g. 15m, 1h) and refresh session lifetime in days
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Cloudinary (image uploads; optional — uploads return 503 when unset) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
